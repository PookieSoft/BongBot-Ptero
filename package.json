{
    "name": "@pookiesoft/bongbot-ptero",
    "version": "0.1.0",
    "description": "BongBot Pterodactyl Server Management",
    "main": "./dist/index.js",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "!dist/standalone.*"
    ],
    "publishConfig": {
        "registry": "https://npm.pkg.github.com"
    },
    "scripts": {
        "build": "node esbuild.config.mjs --minify",
        "build:lib": "node esbuild.config.mjs --lib && npx tsc --emitDeclarationOnly",
        "prepublishOnly": "npm run build:lib",
        "build-dev": "docker build --secret id=NODE_AUTH_TOKEN,env=NODE_AUTH_TOKEN -t bongbot-ptero . && docker run --rm --env-file .env --volume ./data:/app/data --volume ./logs:/app/logs bongbot-ptero",
        "test": "vitest run --coverage"
    },
    "peerDependencies": {
        "better-sqlite3": "^13.0.0",
        "discord.js": "^14.26.3"
    },
    "devDependencies": {
        "@pookiesoft/bongbot-core": "^1.6.43",
        "@types/better-sqlite3": "^9.6.0",
        "@vitest/coverage-v8": "^5.0.0",
        "better-sqlite3": "^13.0.3",
        "discord.js": "^14.26.3",
        "esbuild": "^0.28.0",
        "msw": "^2.14.2",
        "prettier": "^3.8.3",
        "ts-node": "^10.9.2",
        "typescript": "^6.0.3",
        "vitest": "^5.0.0"
    }
}
